<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260318-09-delete-nullable-constraint-firstname-lastname-user_accounts" author="Viacheslav Iakovlev">
        <comment>Delete nullable constraint for firstname and lastname fields in user_accounts table</comment>
        <dropNotNullConstraint tableName="user_accounts" columnName="first_name"/>
        <dropNotNullConstraint tableName="user_accounts" columnName="last_name"/>
    </changeSet>

</databaseChangeLog>