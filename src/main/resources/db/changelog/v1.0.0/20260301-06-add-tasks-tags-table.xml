<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260301-01-create-tasks-tags-table" author="Viacheslav Iakovlev">
        <comment>Create table tasks_tags</comment>
        <createTable tableName="tasks_tags">
            <column name="task_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addPrimaryKey tableName="tasks_tags"
                       columnNames="task_id, tag_id"
                       constraintName="pk_tasks_tags"/>
        
        <addForeignKeyConstraint baseTableName="tasks_tags"
                                 baseColumnNames="task_id"
                                 constraintName="fk_tasks_tags_task"
                                 referencedTableName="tasks"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="tasks_tags"
                                 baseColumnNames="tag_id"
                                 constraintName="fk_tasks_tags_tag"
                                 referencedTableName="tags"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>