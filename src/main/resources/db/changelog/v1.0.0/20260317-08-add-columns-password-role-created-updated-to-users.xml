<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="20260317-08-add-columns-password-role-created-updated-to-users-table" author="Viacheslav Iakovlev">
        <comment>Add column password_hash to users table</comment>
        <addColumn tableName="users">
            <column name="password_hash" type="varchar(68)"/>
        </addColumn>
        <addNotNullConstraint tableName="users" columnName="password_hash"/>
        <addColumn tableName="users">
            <column name="role" type="varchar(20)"/>
        </addColumn>
        <addNotNullConstraint tableName="users" columnName="role"/>
        <addColumn tableName="users">
            <column name="created_at" type="TIMESTAMP WITH TIMEZONE"/>
        </addColumn>
        <addNotNullConstraint tableName="users" columnName="created_at"/>
        <addColumn tableName="users">
            <column name="updated_at" type="TIMESTAMP WITH TIMEZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>